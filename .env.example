# Supabase - من صفحة Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# رقم المتجر على واتساب (كود الدولة + الرقم بدون + أو صفر)
NEXT_PUBLIC_STORE_PHONE=201234567890

# رابط الكتالوج (بعد النشر)
CATALOG_URL=https://your-app.vercel.app

# رابط الدفع الإلكتروني (اختياري)
PAYMENT_URL=https://pay.example.com

# Wapolit (من حسابك على Wapolit)
WAPOLIT_API_URL=https://api.wapolit.com
WAPOLIT_API_KEY=your-wapolit-api-key
